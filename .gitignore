build/
install/
log/
*.pyc
__pycache__/

# Artefatos de treino YOLO (usar GitHub Releases para distribuir best.pt)
runs/
dataset/

# Modelo treinado — versionar via Release, não no repo
*.pt
*.onnx

# Modelos PPO treinados (pesados, distribuir via Release)
models/

# Logs de treino
train.log

# TF frames gerados por view_frames
frames_*.gv
frames_*.pdf
# Viewer HTML efêmero
dataset_viewer.html

# Artefatos de compilação LaTeX (pdflatex gera a cada build, docs/*/main.pdf
# é o único produto versionado) — escopo em docs/ para não capturar .log de
# scripts/nós ROS2 fora dos diretórios de paper/slide
docs/**/*.aux
docs/**/*.fdb_latexmk
docs/**/*.fls
docs/**/*.log
docs/**/*.nav
docs/**/*.out
docs/**/*.snm
docs/**/*.synctex.gz
docs/**/*.toc

# PDFs de terceiros da revisão de literatura (material bruto, não citável
# diretamente — direitos autorais + tamanho não pertencem ao repo)
docs/RSL/

# Frames intermediários de animação (regeráveis via scripts/animate_allocation.py
# e scripts/gen_slides_gif.py) — só o produto final (docs/allocation_nearest_free.gif)
# é versionado
docs/allocation_frames/
docs/allocation_frames_clean/
docs/allocation_frames_fluid/
